{
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/joudy", "destination": "/joudy/index.html" },
    { "source": "/flousy", "destination": "/index.html" },
    { "source": "/flousy/privacy-policy", "destination": "/index.html" },
    { "source": "/flousy/delete-account", "destination": "/index.html" },
    { "source": "/flousy/delete-data", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
